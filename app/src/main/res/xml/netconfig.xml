<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止明文 HTTP；Manifest 的 usesCleartextTraffic 会被本文件覆盖 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        KNOWN_V1_RISK: these two official legacy school services currently require HTTP.
        Cleartext remains denied for every other host; TLS and hostname verification are not
        weakened. Remove this compatibility block when the school exposes equivalent HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">xk.csust.edu.cn</domain>
        <domain includeSubdomains="false">pt.csust.edu.cn</domain>
    </domain-config>
</network-security-config>
