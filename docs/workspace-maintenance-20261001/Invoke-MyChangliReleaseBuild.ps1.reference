#requires -Version 5.1

[CmdletBinding()]
param(
    [ValidateSet("Debug", "Release")]
    [string]$Variant = "Release",
    [string]$AndroidRepo,
    [switch]$DryRun
)

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

function Escape-JavaPropertyValue {
    param([AllowNull()][string]$Value)

    if ($null -eq $Value) { return "" }
    $builder = New-Object System.Text.StringBuilder
    foreach ($character in $Value.ToCharArray()) {
        switch ([int][char]$character) {
            92 { [void]$builder.Append("\"); [void]$builder.Append("\") }
            61 { [void]$builder.Append("\=") }
            58 { [void]$builder.Append("\:") }
            35 { [void]$builder.Append("\#") }
            33 { [void]$builder.Append("\!") }
            10 { [void]$builder.Append("\n") }
            13 { [void]$builder.Append("\r") }
            default {
                $codePoint = [int][char]$character
                if ($codePoint -lt 32 -or $codePoint -gt 126) {
                    [void]$builder.Append(("\u{0:X4}" -f $codePoint))
                } else {
                    [void]$builder.Append($character)
                }
            }
        }
    }
    return $builder.ToString()
}

function Convert-SecureValueToPlainText {
    param([Parameter(Mandatory = $true)][object]$Value)

    if ($Value -is [System.Management.Automation.PSCredential]) {
        return $Value.GetNetworkCredential().Password
    }
    if ($Value -is [System.Security.SecureString]) {
        $pointer = [System.IntPtr]::Zero
        try {
            $pointer = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($Value)
            return [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer)
        } finally {
            if ($pointer -ne [System.IntPtr]::Zero) {
                [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer)
            }
        }
    }
    throw "Signing credential record is invalid."
}

$recordPath = Join-Path $env:LOCALAPPDATA "MyChangli\Secrets\android-signing.clixml"
$record = $null
if (Test-Path -LiteralPath $recordPath -PathType Leaf) {
    $record = Import-Clixml -LiteralPath $recordPath
}

if ([string]::IsNullOrWhiteSpace($AndroidRepo)) {
    $AndroidRepo = 'D:\Codex\01_App-应用开发\001_MyChangLi-我的长理\01_Source-当前源码\01_Android'
}
& 'D:\Codex\01_App-应用开发\001_MyChangLi-我的长理\04_Tools\Test-MyChangliSourceIdentity.ps1' -Component android -Repository $AndroidRepo

$repoPath = (Resolve-Path -LiteralPath $AndroidRepo -ErrorAction Stop).Path
$gradle = Join-Path $repoPath "gradlew.bat"
if (-not (Test-Path -LiteralPath $gradle -PathType Leaf)) {
    throw "AndroidRepo does not contain gradlew.bat: $repoPath"
}

$task = if ($Variant -eq "Release") { "assembleRelease" } else { "assembleDebug" }
$temporaryRunRoot = Join-Path $env:LOCALAPPDATA "MyChangli\Runs"
$temporaryRunDirectory = $null
$temporarySigningConfig = $null
$previousSigningConfig = $env:MY_CHANGLI_SIGNING_CONFIG
$locationPushed = $false
$buildExitCode = 0

try {
    if ($Variant -eq "Release") {
        if ($null -eq $record) {
            throw "Release signing record is missing: $recordPath"
        }
        foreach ($propertyName in @("StoreFile", "KeyAlias", "StorePassword", "KeyPassword")) {
            if (-not $record.PSObject.Properties[$propertyName]) {
                throw "Release signing record is missing '$propertyName'. Re-run the enrollment script."
            }
        }

        $storePath = (Resolve-Path -LiteralPath ([string]$record.StoreFile) -ErrorAction Stop).Path
        $keyAlias = [string]$record.KeyAlias
        if ([string]::IsNullOrWhiteSpace($keyAlias)) {
            throw "Release signing record contains an empty signing value. Re-run the enrollment script."
        }

        if ($DryRun) {
            Write-Host "Android task: $task" -ForegroundColor Cyan
            Write-Host "Android repo: $repoPath" -ForegroundColor DarkGray
            Write-Host "Signing record: present and paths validated; password was not decrypted." -ForegroundColor DarkGray
            Write-Host "DRY RUN: Gradle was not executed and no APK was produced." -ForegroundColor Yellow
            return
        }

        $storePassword = Convert-SecureValueToPlainText -Value $record.StorePassword
        $keyPassword = Convert-SecureValueToPlainText -Value $record.KeyPassword
        if ([string]::IsNullOrWhiteSpace($storePassword) -or [string]::IsNullOrWhiteSpace($keyPassword)) {
            throw "Release signing record contains an empty password. Re-run the enrollment script."
        }

        New-Item -ItemType Directory -Path $temporaryRunRoot -Force | Out-Null
        $temporaryRunDirectory = Join-Path $temporaryRunRoot ([guid]::NewGuid().ToString("N"))
        New-Item -ItemType Directory -Path $temporaryRunDirectory -Force | Out-Null
        $temporarySigningConfig = Join-Path $temporaryRunDirectory "signing.properties"
        $properties = @(
            "storeFile=$(Escape-JavaPropertyValue $storePath)",
            "storePassword=$(Escape-JavaPropertyValue $storePassword)",
            "keyAlias=$(Escape-JavaPropertyValue $keyAlias)",
            "keyPassword=$(Escape-JavaPropertyValue $keyPassword)"
        )
        $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
        [System.IO.File]::WriteAllLines($temporarySigningConfig, $properties, $utf8NoBom)
        $env:MY_CHANGLI_SIGNING_CONFIG = $temporarySigningConfig
    }

    Write-Host "Android task: $task" -ForegroundColor Cyan
    Write-Host "Android repo: $repoPath" -ForegroundColor DarkGray
    if ($Variant -eq "Release") {
        Write-Host "Signing: local DPAPI record + temporary child-process config (passwords hidden)" -ForegroundColor DarkGray
    }

    if ($DryRun) {
        Write-Host "DRY RUN: Gradle was not executed and no APK was produced." -ForegroundColor Yellow
        return
    }

    Push-Location -LiteralPath $repoPath
    $locationPushed = $true
    & $gradle $task "--no-daemon" "--console=plain"
    $buildExitCode = $LASTEXITCODE
    if ($buildExitCode -ne 0) {
        throw "Gradle task failed with exit code $buildExitCode."
    }

    $artifactRoot = Join-Path $repoPath "app\build\outputs\apk"
    if (Test-Path -LiteralPath $artifactRoot -PathType Container) {
        $artifacts = @(Get-ChildItem -LiteralPath $artifactRoot -Filter "*.apk" -File -Recurse | Sort-Object LastWriteTime -Descending)
        if ($artifacts.Count -gt 0) {
            Write-Host "APK artifacts and SHA-256:" -ForegroundColor Green
            foreach ($artifact in $artifacts) {
                $hash = (Get-FileHash -LiteralPath $artifact.FullName -Algorithm SHA256).Hash
                Write-Host ("{0}  {1}" -f $hash, $artifact.FullName)
            }
        } else {
            Write-Warning "Gradle succeeded but no APK was found under $artifactRoot"
        }
    }
} finally {
    if ($locationPushed) {
        Pop-Location
    }
    if ($null -eq $previousSigningConfig) {
        Remove-Item Env:MY_CHANGLI_SIGNING_CONFIG -ErrorAction SilentlyContinue
    } else {
        $env:MY_CHANGLI_SIGNING_CONFIG = $previousSigningConfig
    }
    if ($null -ne $temporaryRunDirectory -and (Test-Path -LiteralPath $temporaryRunDirectory)) {
        Remove-Item -LiteralPath $temporaryRunDirectory -Recurse -Force -ErrorAction SilentlyContinue
    }
}

if ($buildExitCode -ne 0) {
    exit $buildExitCode
}
