<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MyChangli" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/color_primary_blue</item>
        <item name="android:windowBackground">@color/color_base_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MyChangli" parent="Base.Theme.MyChangli"></style>

    <!-- Android 11 and earlier launch window. Android 12+ overrides this style in values-v31. -->
    <style name="Theme.MyChangli.Starting" parent="Theme.MyChangli">
        <item name="android:windowBackground">@drawable/my_changli_splash_background</item>
    </style>

    <!--ShapeableImageView 圆角-->
    <style name="RoundedStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="MyTabLayout">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/login_button</item>
    </style>

</resources>
